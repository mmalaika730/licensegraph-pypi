# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Any OpenAI-compatible chat endpoint works. Examples:
#
# Google Gemini (free tier, key from https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Groq (free tier, key from https://console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# Local Ollama (no key needed):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=500
