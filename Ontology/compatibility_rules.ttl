@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# GENERATED by make_rules_ttl.py from Dataset/curated/compatibility_rules.csv. Edit the CSV, not this file.

src:APACHE_GPL a lg:Source ; rdfs:label "GPL compatibility" ; lg:sourcePublisher "The Apache Software Foundation" ;
    lg:sourceUrl "https://www.apache.org/licenses/GPL-compatibility"^^xsd:anyURI ; lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime .

src:FSF_FAQ_POST a lg:Source ; rdfs:label "Licensing and Compliance Lab: The most frequently asked Frequently Asked Questions" ; lg:sourcePublisher "Free Software Foundation (Jake Glass), published 2019-01-25" ;
    lg:sourceUrl "https://www.fsf.org/blogs/licensing/licensing-and-compliance-lab-the-most-frequently-asked-frequently-asked-questions"^^xsd:anyURI ; lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime .

src:QT_LGPL a lg:Source ; rdfs:label "Obligations of the LGPL" ; lg:sourcePublisher "The Qt Company" ;
    lg:sourceUrl "https://qt.io/licensing/open-source-lgpl-obligations"^^xsd:anyURI ; lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime .

src:MPL_FAQ a lg:Source ; rdfs:label "MPL 2.0 FAQ" ; lg:sourcePublisher "Mozilla" ;
    lg:sourceUrl "https://www.mozilla.org/en-US/MPL/2.0/FAQ/"^^xsd:anyURI ; lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime .

src:KEMITCHELL_AGPL a lg:Source ; rdfs:label "Reading AGPL: a guided introduction for first-timers" ; lg:sourcePublisher "Kyle E. Mitchell" ;
    lg:sourceUrl "https://writing.kemitchell.com/2021/01/24/Reading-AGPL"^^xsd:anyURI ; lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime .

rule:R1 a lg:CompatibilityRule ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "cited" ;
    rdfs:comment "A permissive project that incorporates strong-copyleft code becomes a derivative work that must be distributed under the GPL, which conflicts with keeping the permissive license (Apache page: GPLv3 software cannot be included in Apache projects)." ;
    lg:ruleSource src:APACHE_GPL, src:FSF_FAQ_POST .

rule:R2 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "cited" ;
    rdfs:comment "Linking statically or dynamically with a GPL module makes a combined work based on it (FSF post), which must then be distributed under the GPL; this is incompatible with a proprietary license." ;
    lg:ruleSource src:APACHE_GPL, src:FSF_FAQ_POST .

rule:R3 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Design decision by analogy with R2 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL. Nuance from the Kemitchell guide: AGPL section 13 is triggered by modification plus remote network interaction; running an unmodified program does not trigger it." .

rule:R4 a lg:CompatibilityRule ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Design decision by analogy with R1 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R5 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "cited" ;
    rdfs:comment "Allowed under conditions: with dynamic linking the application source may stay proprietary, with static linking it may not (Qt LGPL page); MPL copyleft is file-level and new files are not Modifications (MPL FAQ Q11). The library stays under its own license, and its source and license text must be provided." ;
    lg:ruleSource src:QT_LGPL, src:MPL_FAQ .

rule:R6 a lg:CompatibilityRule ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "cited" ;
    rdfs:comment "Same conditions as R5: the weak-copyleft component keeps its own license obligations (library source, license text, relinking), the rest of the project can stay permissive." ;
    lg:ruleSource src:QT_LGPL, src:MPL_FAQ .

rule:R7 a lg:CompatibilityRule ;
    lg:projectCategory lg:License ;
    lg:dependencyCategory lg:UnknownLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "A dependency whose license is unknown, non-standard or not recorded cannot be assessed; manual review is required. No published source consulted; this is a conservative design choice." .

rule:R8 a lg:CompatibilityRule ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Permissive licenses impose only notice/attribution conditions, so a permissive project can depend on permissive packages. No published source consulted in this iteration." .

rule:R9 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Permissive licenses allow use in proprietary products subject to attribution. No published source consulted in this iteration." .

rule:R10 a lg:CompatibilityRule ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "cited" ;
    rdfs:comment "Permissively licensed code can be included in GPL projects; example given for Apache 2 into GPLv3. Exception handled at license level: GPL-2.0-only with Apache-2.0 (see incompatibleWith)." ;
    lg:ruleSource src:APACHE_GPL .

rule:R11 a lg:CompatibilityRule ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Same reasoning as R10 applied to AGPL projects. No published source consulted for this exact pair." .

rule:R12 a lg:CompatibilityRule ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Permissive dependencies can be used under a weak-copyleft project. No published source consulted in this iteration." .

rule:R13 a lg:CompatibilityRule ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "cited" ;
    rdfs:comment "GPLv3 and AGPLv3 are bridged by the second paragraph of AGPL section 13, so code can be combined; this holds for GPLv3 only, so the specific version must be checked." ;
    lg:ruleSource src:KEMITCHELL_AGPL .

rule:R14 a lg:CompatibilityRule ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "cited" ;
    rdfs:comment "Same GPLv3/AGPLv3 bridge as R13 in the other direction (Kemitchell guide). GPLv3 only." ;
    lg:ruleSource src:KEMITCHELL_AGPL .

rule:R15 a lg:CompatibilityRule ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "GPL versions can be incompatible with each other (for example GPL-2.0-only code with GPL-3.0 code). No published source consulted in this iteration; check versions manually." .

rule:R16 a lg:CompatibilityRule ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Combination usually possible but depends on the specific LGPL/MPL terms and versions. No published source consulted in this iteration." .

rule:R17 a lg:CompatibilityRule ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Depends on the specific weak-copyleft terms (MPL 2.0 Secondary License mechanism covers GPL and LGPL, not AGPL, per the MPL FAQ Q14). Check manually." .

rule:R18 a lg:CompatibilityRule ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:verdict lg:Compatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Same license family. No published source consulted for exact version combinations." .

rule:R19 a lg:CompatibilityRule ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "cited" ;
    rdfs:comment "A project that incorporates strong-copyleft code must be distributed under the GPL, so it cannot remain under a weak-copyleft license." ;
    lg:ruleSource src:APACHE_GPL, src:FSF_FAQ_POST .

rule:R20 a lg:CompatibilityRule ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Design decision by analogy with R19 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R21 a lg:CompatibilityRule ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Weak-copyleft licenses differ (LGPL, MPL, EPL, CDDL). MPL 2.0 allows combination with LGPL through Secondary Licenses (MPL FAQ Q14); other pairs need manual review." .

rule:R22 a lg:CompatibilityRule ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "cited" ;
    rdfs:comment "A GPL project cannot incorporate proprietary code that is not licensed under GPL-compatible terms (combined-work reasoning)." ;
    lg:ruleSource src:FSF_FAQ_POST .

rule:R23 a lg:CompatibilityRule ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:verdict lg:Incompatible ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Design decision by analogy with R22 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R24 a lg:CompatibilityRule ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Depends on how the proprietary component is linked and licensed. No published source consulted." .

rule:R25 a lg:CompatibilityRule ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "A proprietary dependency's terms vary and may forbid redistribution. No published source consulted; review the dependency's terms." .

rule:R26 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "Depends on the two commercial agreements. No published source consulted." .

rule:R27 a lg:CompatibilityRule ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:dependencyCategory lg:UnknownLicense ;
    lg:verdict lg:Conditional ;
    lg:ruleStatus "design decision" ;
    rdfs:comment "See R7." .
