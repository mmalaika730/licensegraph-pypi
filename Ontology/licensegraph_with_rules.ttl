@prefix lg: <http://example.org/licensegraph#> .
@prefix lic: <http://example.org/licensegraph/license/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rule: <http://example.org/licensegraph/rule/> .
@prefix src: <http://example.org/licensegraph/source/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/licensegraph> a owl:Ontology ;
    rdfs:label "LicenseGraph-PyPI Ontology" ;
    rdfs:comment "T-Box for open-source license conflict reasoning over Python dependency trees. Dependency and license facts are recorded per package VERSION, as in deps.dev." .

lg:PublicDomainLicense a owl:Class ;
    rdfs:label "Public-domain-like license" ;
    rdfs:subClassOf lg:PermissiveLicense .

lg:conflictDependency a owl:ObjectProperty ;
    rdfs:domain lg:LicenseConflict ;
    rdfs:range lg:PackageVersion .

lg:conflictLicense a owl:ObjectProperty ;
    rdfs:comment "The dependency license that triggered the conflict." ;
    rdfs:domain lg:LicenseConflict ;
    rdfs:range lg:License .

lg:conflictProject a owl:ObjectProperty ;
    rdfs:domain lg:LicenseConflict ;
    rdfs:range lg:Project .

lg:conflictRule a owl:ObjectProperty ;
    rdfs:domain lg:LicenseConflict ;
    rdfs:range lg:CompatibilityRule .

lg:conflictVerdict a owl:ObjectProperty ;
    rdfs:comment "Incompatible, or Conditional (needs review)." ;
    rdfs:domain lg:LicenseConflict ;
    rdfs:range lg:Verdict .

lg:declaredLicenseString a owl:DatatypeProperty ;
    rdfs:comment "Raw license value from deps.dev, kept for provenance." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:string .

lg:dependencyCategory a owl:ObjectProperty ;
    rdfs:domain lg:CompatibilityRule .

lg:directlyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Stored fact: a direct edge in the deps.dev resolved dependency graph." ;
    rdfs:subPropertyOf lg:dependsOn .

lg:hasMultipleDeclaredLicenses a owl:DatatypeProperty ;
    rdfs:comment "True when more than one license id was parsed. May be dual licensing (OR) or stacked (AND); check declaredLicenseString." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:boolean .

lg:hasVersion a owl:ObjectProperty ;
    rdfs:domain lg:Package ;
    rdfs:range lg:PackageVersion ;
    owl:inverseOf lg:versionOf .

lg:heldOutLink a owl:DatatypeProperty ;
    rdfs:comment "True when the true license link was hidden from the model during training (a genuine test prediction)." ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range xsd:boolean .

lg:incompatibleWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "License-to-license incompatibility (e.g. GPL-2.0-only with Apache-2.0)." ;
    rdfs:domain lg:License ;
    rdfs:range lg:License .

lg:isDisjunctiveLicense a owl:DatatypeProperty ;
    rdfs:comment "True when the declared license is an OR expression (dual licensing): the user may pick ONE option, so a conflict through one option may be avoidable." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:boolean .

lg:isFsfLibre a owl:DatatypeProperty ;
    rdfs:comment "From the SPDX License List. Only present where SPDX gives a value." ;
    rdfs:domain lg:License ;
    rdfs:range xsd:boolean .

lg:isOsiApproved a owl:DatatypeProperty ;
    rdfs:comment "From the SPDX License List. Absent for ids not in the list (treat as not confirmed)." ;
    rdfs:domain lg:License ;
    rdfs:range xsd:boolean .

lg:isSeedRoot a owl:DatatypeProperty ;
    rdfs:comment "True for the packages the extraction started from (the analysis roots)." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:boolean .

lg:licenseSource a owl:DatatypeProperty ;
    rdfs:comment "Where the license value came from: license_expression (SPDX), license_text, classifier, manual_override or none. Classifier values are less reliable (e.g. 'BSD License' does not say 2- or 3-clause)." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:string .

lg:predictedLicense a owl:ObjectProperty ;
    rdfs:comment "Deliberately not a sub-property of lg:hasLicense, so reasoning and the conflict rule never treat a prediction as a fact." ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range lg:License .

lg:predictionFor a owl:ObjectProperty ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range lg:PackageVersion .

lg:predictionMethod a owl:DatatypeProperty ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range xsd:string .

lg:predictionRank a owl:DatatypeProperty ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range xsd:integer .

lg:predictionScore a owl:DatatypeProperty ;
    rdfs:comment "TransE plausibility score, minus the squared distance ||h + r - t||^2; higher is more plausible. Not a probability." ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range xsd:decimal .

lg:predictionStatus a owl:DatatypeProperty ;
    rdfs:domain lg:LicensePrediction ;
    rdfs:range xsd:string .

lg:projectCategory a owl:ObjectProperty ;
    rdfs:domain lg:CompatibilityRule .

lg:projectName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Name of the user's own project; a subproperty of packageName." ;
    rdfs:domain lg:Project ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lg:packageName .

lg:ruleSource a owl:ObjectProperty ;
    rdfs:comment "Published source behind a cited rule (traceable evidence for the explanation)." ;
    rdfs:domain lg:CompatibilityRule ;
    rdfs:range lg:Source .

lg:ruleStatus a owl:DatatypeProperty ;
    rdfs:comment "'cited' = backed by a published source we read; 'design decision' = our own conservative choice, no source consulted." ;
    rdfs:domain lg:CompatibilityRule ;
    rdfs:range xsd:string .

lg:sourceAccessed a owl:DatatypeProperty ;
    rdfs:domain lg:Source ;
    rdfs:range xsd:dateTime .

lg:sourcePublisher a owl:DatatypeProperty ;
    rdfs:domain lg:Source ;
    rdfs:range xsd:string .

lg:sourceUrl a owl:DatatypeProperty ;
    rdfs:domain lg:Source ;
    rdfs:range xsd:anyURI .

lg:spdxId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain lg:License ;
    rdfs:range xsd:string .

lg:treeContainsLicense a owl:ObjectProperty ;
    rdfs:comment "Inferred: a license appearing anywhere below a package version." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range lg:License ;
    owl:propertyChainAxiom ( lg:dependsOn lg:hasLicense ) .

lg:verdict a owl:ObjectProperty ;
    rdfs:domain lg:CompatibilityRule ;
    rdfs:range lg:Verdict .

lg:versionString a owl:DatatypeProperty ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range xsd:string .

lic:GPL-2.0-only lg:incompatibleWith lic:Apache-2.0 .

rule:R1 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:ruleSource src:APACHE_GPL,
        src:FSF_FAQ_POST ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "A permissive project that incorporates strong-copyleft code becomes a derivative work that must be distributed under the GPL, which conflicts with keeping the permissive license (Apache page: GPLv3 software cannot be included in Apache projects)." .

rule:R10 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:ruleSource src:APACHE_GPL ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Permissively licensed code can be included in GPL projects; example given for Apache 2 into GPLv3. Exception handled at license level: GPL-2.0-only with Apache-2.0 (see incompatibleWith)." .

rule:R11 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Same reasoning as R10 applied to AGPL projects. No published source consulted for this exact pair." .

rule:R12 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Permissive dependencies can be used under a weak-copyleft project. No published source consulted in this iteration." .

rule:R13 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:ruleSource src:KEMITCHELL_AGPL ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "GPLv3 and AGPLv3 are bridged by the second paragraph of AGPL section 13, so code can be combined; this holds for GPLv3 only, so the specific version must be checked." .

rule:R14 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:ruleSource src:KEMITCHELL_AGPL ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Same GPLv3/AGPLv3 bridge as R13 in the other direction (Kemitchell guide). GPLv3 only." .

rule:R15 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "GPL versions can be incompatible with each other (for example GPL-2.0-only code with GPL-3.0 code). No published source consulted in this iteration; check versions manually." .

rule:R16 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Combination usually possible but depends on the specific LGPL/MPL terms and versions. No published source consulted in this iteration." .

rule:R17 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Depends on the specific weak-copyleft terms (MPL 2.0 Secondary License mechanism covers GPL and LGPL, not AGPL, per the MPL FAQ Q14). Check manually." .

rule:R18 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Same license family. No published source consulted for exact version combinations." .

rule:R19 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:ruleSource src:APACHE_GPL,
        src:FSF_FAQ_POST ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "A project that incorporates strong-copyleft code must be distributed under the GPL, so it cannot remain under a weak-copyleft license." .

rule:R2 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:StrongCopyleftLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleSource src:APACHE_GPL,
        src:FSF_FAQ_POST ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "Linking statically or dynamically with a GPL module makes a combined work based on it (FSF post), which must then be distributed under the GPL; this is incompatible with a proprietary license." .

rule:R20 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "Design decision by analogy with R19 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R21 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Weak-copyleft licenses differ (LGPL, MPL, EPL, CDDL). MPL 2.0 allows combination with LGPL through Secondary Licenses (MPL FAQ Q14); other pairs need manual review." .

rule:R22 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:projectCategory lg:StrongCopyleftLicense ;
    lg:ruleSource src:FSF_FAQ_POST ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "A GPL project cannot incorporate proprietary code that is not licensed under GPL-compatible terms (combined-work reasoning)." .

rule:R23 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:projectCategory lg:NetworkCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "Design decision by analogy with R22 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R24 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:projectCategory lg:WeakCopyleftLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Depends on how the proprietary component is linked and licensed. No published source consulted." .

rule:R25 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "A proprietary dependency's terms vary and may forbid redistribution. No published source consulted; review the dependency's terms." .

rule:R26 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:ProprietaryLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Depends on the two commercial agreements. No published source consulted." .

rule:R27 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:UnknownLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "See R7." .

rule:R3 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "Design decision by analogy with R2 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL. Nuance from the Kemitchell guide: AGPL section 13 is triggered by modification plus remote network interaction; running an unmodified program does not trigger it." .

rule:R4 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:NetworkCopyleftLicense ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Incompatible ;
    rdfs:comment "Design decision by analogy with R1 (AGPL is a GPL-family license). Verified 2026-11-14: no source read states the combined-work consequences for AGPL." .

rule:R5 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleSource src:MPL_FAQ,
        src:QT_LGPL ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Allowed under conditions: with dynamic linking the application source may stay proprietary, with static linking it may not (Qt LGPL page); MPL copyleft is file-level and new files are not Modifications (MPL FAQ Q11). The library stays under its own license, and its source and license text must be provided." .

rule:R6 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:WeakCopyleftLicense ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:ruleSource src:MPL_FAQ,
        src:QT_LGPL ;
    lg:ruleStatus "cited" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "Same conditions as R5: the weak-copyleft component keeps its own license obligations (library source, license text, relinking), the rest of the project can stay permissive." .

rule:R7 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:UnknownLicense ;
    lg:projectCategory lg:License ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Conditional ;
    rdfs:comment "A dependency whose license is unknown, non-standard or not recorded cannot be assessed; manual review is required. No published source consulted; this is a conservative design choice." .

rule:R8 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:projectCategory lg:PermissiveLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Permissive licenses impose only notice/attribution conditions, so a permissive project can depend on permissive packages. No published source consulted in this iteration." .

rule:R9 a lg:CompatibilityRule ;
    lg:dependencyCategory lg:PermissiveLicense ;
    lg:projectCategory lg:ProprietaryLicense ;
    lg:ruleStatus "design decision" ;
    lg:verdict lg:Compatible ;
    rdfs:comment "Permissive licenses allow use in proprietary products subject to attribution. No published source consulted in this iteration." .

lg:dependencyOf a owl:ObjectProperty .

lg:hasLicense a owl:ObjectProperty ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range lg:License .

lg:packageName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Name of a package or of the user's project. Deliberately has no rdfs:domain: it is used on Package and on Project, and Package is disjoint from PackageVersion (a domain would make every Project inconsistent)." ;
    rdfs:range xsd:string .

lg:versionOf a owl:ObjectProperty .

lg:Package a owl:Class ;
    rdfs:label "Package" ;
    rdfs:comment "A PyPI project by name, independent of version (pkg:requests)." ;
    owl:disjointWith lg:License,
        lg:PackageVersion .

lg:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "The user's own project, treated as a package version that is audited." ;
    rdfs:subClassOf lg:PackageVersion .

lg:UnknownLicense a owl:Class ;
    rdfs:label "Unknown / unrecognised license" ;
    rdfs:subClassOf lg:License .

lg:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Transitive closure of direct dependency; inferred, not stored." ;
    rdfs:domain lg:PackageVersion ;
    rdfs:range lg:PackageVersion ;
    owl:inverseOf lg:dependencyOf .

src:KEMITCHELL_AGPL a lg:Source ;
    rdfs:label "Reading AGPL: a guided introduction for first-timers" ;
    lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime ;
    lg:sourcePublisher "Kyle E. Mitchell" ;
    lg:sourceUrl "https://writing.kemitchell.com/2021/01/24/Reading-AGPL"^^xsd:anyURI .

src:MPL_FAQ a lg:Source ;
    rdfs:label "MPL 2.0 FAQ" ;
    lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime ;
    lg:sourcePublisher "Mozilla" ;
    lg:sourceUrl "https://www.mozilla.org/en-US/MPL/2.0/FAQ/"^^xsd:anyURI .

src:QT_LGPL a lg:Source ;
    rdfs:label "Obligations of the LGPL" ;
    lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime ;
    lg:sourcePublisher "The Qt Company" ;
    lg:sourceUrl "https://qt.io/licensing/open-source-lgpl-obligations"^^xsd:anyURI .

lg:CopyleftLicense a owl:Class ;
    rdfs:label "Copyleft license" ;
    rdfs:subClassOf lg:License ;
    owl:disjointWith lg:ProprietaryLicense .

src:APACHE_GPL a lg:Source ;
    rdfs:label "GPL compatibility" ;
    lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime ;
    lg:sourcePublisher "The Apache Software Foundation" ;
    lg:sourceUrl "https://www.apache.org/licenses/GPL-compatibility"^^xsd:anyURI .

src:FSF_FAQ_POST a lg:Source ;
    rdfs:label "Licensing and Compliance Lab: The most frequently asked Frequently Asked Questions" ;
    lg:sourceAccessed "2026-11-04T00:00:00"^^xsd:dateTime ;
    lg:sourcePublisher "Free Software Foundation (Jake Glass), published 2019-01-25" ;
    lg:sourceUrl "https://www.fsf.org/blogs/licensing/licensing-and-compliance-lab-the-most-frequently-asked-frequently-asked-questions"^^xsd:anyURI .

lg:LicenseConflict a owl:Class ;
    rdfs:label "License conflict" ;
    rdfs:comment "Inferred: a project whose dependency tree contains an incompatible license." .

lg:Verdict a owl:Class ;
    rdfs:label "Verdict" .

lg:Compatible a lg:Verdict ;
    rdfs:label "Compatible" .

lg:LicensePrediction a owl:Class ;
    rdfs:label "License prediction" ;
    rdfs:comment "Iteration 2: a license suggested by the TransE link-prediction model for a package version. A prediction is NOT a stored or inferred fact; it is never connected with lg:hasLicense." ;
    owl:disjointWith lg:CompatibilityRule,
        lg:License,
        lg:Package,
        lg:PackageVersion .

lg:Incompatible a lg:Verdict ;
    rdfs:label "Incompatible" .

lg:Source a owl:Class ;
    rdfs:label "Source" ;
    rdfs:comment "A published guide or FAQ that a compatibility rule is based on." .

lg:NetworkCopyleftLicense a owl:Class ;
    rdfs:label "Network copyleft license" ;
    rdfs:subClassOf lg:StrongCopyleftLicense .

lg:WeakCopyleftLicense a owl:Class ;
    rdfs:label "Weak copyleft license" ;
    rdfs:subClassOf lg:CopyleftLicense .

lg:PermissiveLicense a owl:Class ;
    rdfs:label "Permissive license" ;
    rdfs:subClassOf lg:License ;
    owl:disjointWith lg:CopyleftLicense,
        lg:ProprietaryLicense .

lg:StrongCopyleftLicense a owl:Class ;
    rdfs:label "Strong copyleft license" ;
    rdfs:subClassOf lg:CopyleftLicense .

lg:Conditional a lg:Verdict ;
    rdfs:label "Conditional" .

lg:ProprietaryLicense a owl:Class ;
    rdfs:label "Proprietary license" ;
    rdfs:subClassOf lg:License .

lg:PackageVersion a owl:Class ;
    rdfs:label "Package version" ;
    rdfs:comment "One resolved release of a package. Licenses and dependencies attach here." ;
    owl:disjointWith lg:License .

lg:License a owl:Class ;
    rdfs:label "License" .

lg:CompatibilityRule a owl:Class ;
    rdfs:label "Compatibility rule" ;
    rdfs:comment "Curated rule: project-license category vs dependency-license category gives a verdict." .

