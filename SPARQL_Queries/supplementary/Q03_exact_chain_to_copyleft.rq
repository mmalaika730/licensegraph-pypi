# Q03 | Exact dependency chain to every copyleft license   (CQ3, CQ7, CQ15)
# Features: multi-hop traversal, UNION (root selection and one branch per depth), subclass path
# Parameter: ?rootName  = a project name or a seed package name.
# Depth: chains of 1 to 5 hops. For CQ7 ("copyleft at depth 3 or more") add FILTER(?depth >= 3).
# Limit: a branch per depth is needed because SPARQL cannot return the path itself.
# For deeper trees, extend the pattern with more branches, or rebuild the chain in application code.
# The chain labels show name/version, so the exact resolved release is visible (CQ15).

PREFIX lg:   <http://example.org/licensegraph#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?depth ?chain ?licenseId
WHERE {
  VALUES ?rootName { "acme-mit-app" }
  { ?root a lg:Project ; lg:projectName ?rootName }
  UNION
  { ?pkg lg:packageName ?rootName ; lg:hasVersion ?root . ?root lg:isSeedRoot true }

  {
    ?root lg:directlyDependsOn ?n1 .
    BIND (?n1 AS ?dep)
    BIND (1 AS ?depth)
    BIND (CONCAT(REPLACE(STR(?root), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n1), "^.*/(ver|project)/", "")) AS ?chain)
  }
  UNION
  {
    ?root lg:directlyDependsOn ?n1 .
    ?n1 lg:directlyDependsOn ?n2 .
    BIND (?n2 AS ?dep)
    BIND (2 AS ?depth)
    BIND (CONCAT(REPLACE(STR(?root), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n1), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n2), "^.*/(ver|project)/", "")) AS ?chain)
  }
  UNION
  {
    ?root lg:directlyDependsOn ?n1 .
    ?n1 lg:directlyDependsOn ?n2 .
    ?n2 lg:directlyDependsOn ?n3 .
    BIND (?n3 AS ?dep)
    BIND (3 AS ?depth)
    BIND (CONCAT(REPLACE(STR(?root), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n1), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n2), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n3), "^.*/(ver|project)/", "")) AS ?chain)
  }
  UNION
  {
    ?root lg:directlyDependsOn ?n1 .
    ?n1 lg:directlyDependsOn ?n2 .
    ?n2 lg:directlyDependsOn ?n3 .
    ?n3 lg:directlyDependsOn ?n4 .
    BIND (?n4 AS ?dep)
    BIND (4 AS ?depth)
    BIND (CONCAT(REPLACE(STR(?root), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n1), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n2), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n3), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n4), "^.*/(ver|project)/", "")) AS ?chain)
  }
  UNION
  {
    ?root lg:directlyDependsOn ?n1 .
    ?n1 lg:directlyDependsOn ?n2 .
    ?n2 lg:directlyDependsOn ?n3 .
    ?n3 lg:directlyDependsOn ?n4 .
    ?n4 lg:directlyDependsOn ?n5 .
    BIND (?n5 AS ?dep)
    BIND (5 AS ?depth)
    BIND (CONCAT(REPLACE(STR(?root), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n1), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n2), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n3), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n4), "^.*/(ver|project)/", ""), " -> ", REPLACE(STR(?n5), "^.*/(ver|project)/", "")) AS ?chain)
  }

  ?dep lg:hasLicense ?lic .
  ?lic a/rdfs:subClassOf* lg:CopyleftLicense ;
       lg:spdxId ?licenseId .
}
ORDER BY ?depth ?chain ?licenseId
